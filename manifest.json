{
  "manifest_version": 3,
  "name": "Trustpilot Lookup",
  "version": "1.2",
  "description": "Check a site's Trustpilot rating on demand in Firefox or Chromium based browsers.",
  "permissions": ["activeTab", "storage", "tabs", "contextMenus"],
  "host_permissions": ["https://*.trustpilot.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "ff-trustpilot-lookup-plugin@kristinx10",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Check Trustpilot Rating",
    "default_icon": {
      "16": "src/icon/icon16.png",
      "32": "src/icon/icon32.png",
      "48": "src/icon/icon48.png",
      "128": "src/icon/icon128.png"
    }
  },
  "background": {
    "scripts": ["src/background.js"],
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "src/icon/icon16.png",
    "32": "src/icon/icon32.png",
    "48": "src/icon/icon48.png",
    "128": "src/icon/icon128.png"
  }
}
